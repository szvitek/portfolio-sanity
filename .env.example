# ── Sanity Studio ──────────────────────────────────────────
# Required. Your Sanity project ID — find it in sanity.json or
# the Sanity manage console at https://manage.sanity.io
SANITY_STUDIO_PROJECT_ID="your-project-id"

# Optional. Defaults to "production" if unset.
SANITY_STUDIO_DATASET="production"

# ── Next.js frontend ───────────────────────────────────────
# Required for the Next.js app to connect to Sanity.
# These are public (NEXT_PUBLIC_) and exposed to the browser.
NEXT_PUBLIC_SANITY_PROJECT_ID="your-project-id"
NEXT_PUBLIC_SANITY_DATASET="production"

# ── Sanity API token ───────────────────────────────────────
# Required when your dataset is private. Generate one at
# https://manage.sanity.io/projects/<projectId>/api
SANITY_API_TOKEN="your-api-token"
