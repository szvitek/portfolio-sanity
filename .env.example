# ── Sanity Studio ──────────────────────────────────────────
# Required. Your Sanity project ID — find it in sanity.json or
# the Sanity manage console at https://manage.sanity.io
SANITY_STUDIO_PROJECT_ID="your-project-id"

# Optional. Defaults to "production" if unset.
SANITY_STUDIO_DATASET="production"

# ── Next.js frontend ───────────────────────────────────────
# Required for the Next.js app to connect to Sanity.
# These are public (NEXT_PUBLIC_) and exposed to the browser.
NEXT_PUBLIC_SANITY_PROJECT_ID="your-project-id"
NEXT_PUBLIC_SANITY_DATASET="production"

# ── Sanity API token ───────────────────────────────────────
# Required when your dataset is private. Generate one at
# https://manage.sanity.io/projects/<projectId>/api
SANITY_API_TOKEN="your-api-token"

# ── Revalidation ───────────────────────────────────────────
# Secret guarding the on-demand revalidation endpoint
# (/api/revalidate). Generate with `openssl rand -hex 24`.
# Set the same value as the `secret` query param on the Sanity
# webhook URL. Server-side only.
REVALIDATE_SECRET="your-revalidate-secret"

# ── Resend (contact form email) ────────────────────────────
# Required for the contact form to work. Get your API key at
# https://resend.com/api-keys
RESEND_API_KEY="re_..."

# Required. The email address where contact form submissions
# are sent.
CONTACT_EMAIL="your-email@example.com"

# Optional. The "from" address for contact emails.
# Defaults to "Portfolio Contact <onboarding@resend.dev>".
# Use a verified domain sender for production.
RESEND_FROM="Portfolio Contact <onboarding@resend.dev>"
