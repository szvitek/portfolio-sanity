# Required for the Next.js app to connect to Sanity.
# These are public (NEXT_PUBLIC_) and exposed to the browser.
NEXT_PUBLIC_SANITY_PROJECT_ID="your-project-id"
NEXT_PUBLIC_SANITY_DATASET="production"

# Required when your dataset is private.
# Generate at https://manage.sanity.io/projects/<projectId>/api
# This is server-side only — never exposed to the browser.
SANITY_API_TOKEN="your-api-token"

# Secret guarding the on-demand revalidation endpoint (/api/revalidate).
# Generate with `openssl rand -hex 24`. Server-side only.
# Pass the same value as the `secret` query param on the Sanity webhook URL.
REVALIDATE_SECRET="your-revalidate-secret"

RESEND_API_KEY="your-resend-api-key"